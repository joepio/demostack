# Demogemeente "Gemeente Voorbeeldstad": voorbeeldconfiguratie.
#
# scripts/up.sh maakt hier een .env van als die nog niet bestaat en vervangt
# elke waarde "__GENEREER__" door een willekeurig geheim. Die geheimen zijn
# alleen voor lokaal gebruik. Commit .env nooit.

# Projectnaam: scripts/stack.sh gebruikt demogemeente-<stack> (dit veld telt niet mee).
COMPOSE_PROJECT_NAME=demogemeente

# Adres waarop de poorten op de host luisteren. 127.0.0.1 = alleen lokaal.
# Zet op 0.0.0.0 om de demo vanaf andere machines bereikbaar te maken.
BIND_ADDRESS=127.0.0.1

# Gegevens van de fictieve gemeente
GEMEENTE_NAAM=Gemeente Voorbeeldstad
# Fictief RSIN (haalt de elfproef, niet in gebruik bij een echte organisatie)
GEMEENTE_RSIN=999990007

# Host-poorten
PORT_OPENZAAK=8001
PORT_OPENNOTIFICATIES=8002
PORT_OPENOBJECT=8003
PORT_OPENKLANT=8004
PORT_OPENPRODUCT=8005
PORT_REFERENTIELIJSTEN=8006
PORT_SELECTIELIJST=8007
PORT_BRP=8010
PORT_KEYCLOAK=8080
PORT_NOTIFICATIE_SINK=8090
PORT_POSTGRES=55432

# Beheerder (Django-admin van alle componenten, Keycloak-admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__GENEREER__

# Postgres
POSTGRES_PASSWORD=__GENEREER__
DB_APP_PASSWORD=__GENEREER__

# Django SECRET_KEYs
SECRET_KEY_OPENZAAK=__GENEREER__
SECRET_KEY_OPENNOTIFICATIES=__GENEREER__
SECRET_KEY_OPENOBJECT=__GENEREER__
SECRET_KEY_OPENKLANT=__GENEREER__
SECRET_KEY_OPENPRODUCT=__GENEREER__
SECRET_KEY_REFERENTIELIJSTEN=__GENEREER__
SECRET_KEY_SELECTIELIJST=__GENEREER__

# ZGW-JWT clients (client_id staat vast, secret wordt gegenereerd)
# demogemeente-beheer: seed-scripts, alle autorisaties
ZGW_BEHEER_CLIENT_ID=demogemeente-beheer
ZGW_BEHEER_SECRET=__GENEREER__
# burgerportaal: alleen lezen op zaken, catalogi en documenten. Voor een plug-in met een
# burgerportaal of Mijn-API (docs/PLUGINS.md), en voor de zgw-tests
ZGW_PORTAAL_CLIENT_ID=burgerportaal
ZGW_PORTAAL_SECRET=__GENEREER__
# Componenten onderling (notificaties publiceren, autorisaties opvragen)
ZGW_OPENZAAK_SECRET=__GENEREER__
ZGW_OPENNOTIFICATIES_SECRET=__GENEREER__
ZGW_OPENOBJECT_SECRET=__GENEREER__
ZGW_OPENKLANT_SECRET=__GENEREER__
ZGW_OPENPRODUCT_SECRET=__GENEREER__

# API-tokens (Authorization: Token ...) voor de registers met tokenauth
OPENOBJECT_BEHEER_TOKEN=__GENEREER__
OPENOBJECT_PORTAAL_TOKEN=__GENEREER__
# Open Zaak leest objecten (controle van zaakobject-URL's)
OPENOBJECT_OPENZAAK_TOKEN=__GENEREER__
OPENKLANT_BEHEER_TOKEN=__GENEREER__
OPENKLANT_PORTAAL_TOKEN=__GENEREER__
OPENPRODUCT_BEHEER_TOKEN=__GENEREER__

# Token waarmee Open Notificaties de notificatie-sink aanroept
NOTIFICATIE_SINK_TOKEN=__GENEREER__

# Keycloak (DigiD-simulatie)
KEYCLOAK_PORTAAL_CLIENT_SECRET=__GENEREER__
# Wachtwoord van alle fictieve inwoners in de DigiD-simulatie
DIGID_SIM_WACHTWOORD=__GENEREER__

# Resources: aantal uWSGI-processen en Celery-workers per component
UWSGI_PROCESSES=2
UWSGI_THREADS=4
CELERY_WORKER_CONCURRENCY=2
