# Extra geheimen voor stack "vcg". scripts/stack.sh vult .env hiermee aan;
# "__GENEREER__" wordt een willekeurig geheim (alleen lokaal gebruiken).

# Host-poorten (bereik van deze stack: 8250 tot en met 8299). Open Beheer houdt de poort
# uit stack dimpact (8155): dezelfde component heeft in elke stack dezelfde hostpoort.
PORT_OPENBEHEER=8155
PORT_OPENORGANISATIE=8251
PORT_PUBLICATIEBANK=8252
PORT_OPERATON=8254
PORT_OPENPLAN=8255
PORT_WORDPRESS=8256
PORT_NEXTCLOUD=8257
PORT_FSC_VOORBEELDSTAD=8260
PORT_FSC_BRP=8261
PORT_FSC_DIRECTORY=8262

# Django SECRET_KEYs
SECRET_KEY_OPENORGANISATIE=__GENEREER__
SECRET_KEY_PUBLICATIEBANK=__GENEREER__
SECRET_KEY_OPENBEHEER=__GENEREER__
SECRET_KEY_OPENPLAN=__GENEREER__

# ZGW-JWT clients bij Open Zaak
ZGW_OPENORGANISATIE_SECRET=__GENEREER__
ZGW_PUBLICATIEBANK_SECRET=__GENEREER__
ZGW_OPENBEHEER_SECRET=__GENEREER__
ZGW_OPERATON_SECRET=__GENEREER__

# API-tokens
OPENORGANISATIE_BEHEER_TOKEN=__GENEREER__
PUBLICATIEBANK_BEHEER_TOKEN=__GENEREER__
PUBLICATIEBANK_PUBLIEK_TOKEN=__GENEREER__
OPENPLAN_BEHEER_TOKEN=__GENEREER__

# Keycloak-realm "vcg" (medewerkers)
KEYCLOAK_OPENBEHEER_CLIENT_SECRET=__GENEREER__
KEYCLOAK_OPENORGANISATIE_CLIENT_SECRET=__GENEREER__
MEDEWERKER_WACHTWOORD=__GENEREER__

# WordPress (OpenPDC en OpenPub) en MariaDB
MARIADB_ROOT_PASSWORD=__GENEREER__
WORDPRESS_AUTH_SALT=__GENEREER__

# OpenRegister (Nextcloud): de beheerder is ADMIN_USERNAME met ADMIN_PASSWORD
