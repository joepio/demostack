# Stack "vcg": de VCG-basisset (code.overheid.nl/CommonGround/vcg-basisset).
STACK_TITEL="VCG-basisset: de componentenlijst van de Voorziening Common Ground"
STACK_STATUS=werkt
STACK_COMPOSE="stacks/kern/compose.yml stacks/vcg/compose.yml"
# Extra databases (config/postgres/10-databases.sh)
DB_EXTRA="openorganisatie publicatiebank openbeheer operaton openplan nextcloud fsc_dir_manager fsc_dir_controller fsc_vbs_manager fsc_vbs_controller fsc_vbs_txlog fsc_brp_manager fsc_brp_controller fsc_brp_txlog"
# Hostpoorten van deze stack: 8250 tot en met 8299 (Open Beheer houdt 8155 uit stack
# dimpact). Redis-databases: 22 tot en met 27.
#
# Versies: de kern volgt de VCG-basisset al. Waar de basisset een versie noemt die niet
# bestaat, staat de reden in stacks/vcg/README.md (Operaton 2.1.12: laatste is 2.1.5).
