# Stack "maykin": alles van Maykin Media, bovenop de kern.
STACK_TITEL="Maykin-landschap: kern plus Open VTB, Open Formulieren en Open Inwoner"
STACK_STATUS=werkt
STACK_COMPOSE="stacks/kern/compose.yml stacks/maykin/compose.yml"
# Extra databases (config/postgres/10-databases.sh)
DB_EXTRA="openvtb:postgis openformulieren:postgis,pg_trgm openinwoner:postgis,pg_trgm"
# Hostpoorten van deze stack: 8100 tot en met 8149. Redis-databases: 12 tot en met 17.
