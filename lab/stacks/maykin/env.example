# Extra geheimen voor stack "maykin". scripts/stack.sh vult .env hiermee aan;
# "__GENEREER__" wordt een willekeurig geheim (alleen lokaal gebruiken).

# Host-poorten (bereik van deze stack: 8100 tot en met 8149)
PORT_OPENVTB=8101
PORT_OPENFORMULIEREN=8102
PORT_OPENINWONER=8103

# Django SECRET_KEYs
SECRET_KEY_OPENVTB=__GENEREER__
SECRET_KEY_OPENFORMULIEREN=__GENEREER__
SECRET_KEY_OPENINWONER=__GENEREER__

# Open VTB: API-tokens (Authorization: Token ...). 40 tekens, zoals DRF ze maakt.
OPENVTB_BEHEER_TOKEN=__GENEREER__
OPENVTB_PORTAAL_TOKEN=__GENEREER__

# Open Formulieren: API-token van de beheergebruiker (seed maakt er formulieren mee)
OPENFORMULIEREN_BEHEER_TOKEN=__GENEREER__

# ZGW-JWT clients van Open Formulieren en Open Inwoner bij Open Zaak
ZGW_OPENFORMULIEREN_SECRET=__GENEREER__
ZGW_OPENINWONER_SECRET=__GENEREER__

# Tokens bij Open Object en Open Klant
OPENOBJECT_OPENFORMULIEREN_TOKEN=__GENEREER__
OPENOBJECT_OPENINWONER_TOKEN=__GENEREER__
OPENKLANT_OPENINWONER_TOKEN=__GENEREER__

# Keycloak-clients (DigiD-simulatie) voor Open Formulieren en Open Inwoner
KEYCLOAK_OPENFORMULIEREN_CLIENT_SECRET=__GENEREER__
KEYCLOAK_OPENINWONER_CLIENT_SECRET=__GENEREER__

# Elasticsearch (zoekfunctie van Open Inwoner)
ELASTIC_PASSWORD=__GENEREER__
ZGW_OPENVTB_SECRET=__GENEREER__
