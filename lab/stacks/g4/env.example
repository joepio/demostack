# Extra geheimen voor stack "g4". scripts/stack.sh vult .env hiermee aan;
# "__GENEREER__" wordt een willekeurig geheim (alleen lokaal gebruiken).
# Twee sleutels met een vaste lengte (IKO_CRYPTO_KEY, GZAC_PLUGIN_ENCRYPTIESLEUTEL) maakt
# stacks/g4/bouw.sh aan.

# Uit stack maykin (Open VTB, Open Formulieren; de compose van maykin vraagt ze)
SECRET_KEY_OPENVTB=__GENEREER__
SECRET_KEY_OPENFORMULIEREN=__GENEREER__
SECRET_KEY_OPENINWONER=__GENEREER__
OPENVTB_BEHEER_TOKEN=__GENEREER__
OPENVTB_PORTAAL_TOKEN=__GENEREER__
OPENFORMULIEREN_BEHEER_TOKEN=__GENEREER__
ZGW_OPENFORMULIEREN_SECRET=__GENEREER__
ZGW_OPENINWONER_SECRET=__GENEREER__
ZGW_OPENVTB_SECRET=__GENEREER__
OPENOBJECT_OPENFORMULIEREN_TOKEN=__GENEREER__
OPENOBJECT_OPENINWONER_TOKEN=__GENEREER__
OPENKLANT_OPENINWONER_TOKEN=__GENEREER__
KEYCLOAK_OPENFORMULIEREN_CLIENT_SECRET=__GENEREER__
KEYCLOAK_OPENINWONER_CLIENT_SECRET=__GENEREER__
ELASTIC_PASSWORD=__GENEREER__

# NL Portal: ZGW-client bij Open Zaak, tokens bij Open Object en Open Klant, en de
# vertrouwelijke Keycloak-client voor token exchange
ZGW_NLPORTAL_SECRET=__GENEREER__
OPENOBJECT_NLPORTAL_TOKEN=__GENEREER__
OPENKLANT_NLPORTAL_TOKEN=__GENEREER__
KEYCLOAK_NLPORTAL_M2M_SECRET=__GENEREER__

# GZAC: ZGW-client (Open Zaak, Open Notificaties), tokens, Keycloak-client voor het
# opvragen van medewerkers
ZGW_GZAC_SECRET=__GENEREER__
ZGW_IKO_SECRET=__GENEREER__
OPENOBJECT_GZAC_TOKEN=__GENEREER__
OPENKLANT_GZAC_TOKEN=__GENEREER__
KEYCLOAK_GZAC_M2M_SECRET=__GENEREER__

# IKO: Keycloak-client (beheer-UI en API)
KEYCLOAK_IKO_SECRET=__GENEREER__

# Wachtwoord van de fictieve medewerkers in realm g4 (GZAC, IKO)
MEDEWERKER_WACHTWOORD=__GENEREER__
