# Stack "g4": de keuze van het Platform Dienstverlening van de G4.
STACK_TITEL="G4 Platform Dienstverlening: NL Portal, Valtimo/GZAC, IKO, Open Formulieren en Open VTB"
STACK_STATUS=werkt
# Open VTB, Open Formulieren en de BRP-vertaler komen uit de compose van maykin;
# stacks/g4/compose.yml zet Open Inwoner en Open Product uit.
STACK_COMPOSE="stacks/kern/compose.yml stacks/maykin/compose.yml stacks/g4/compose.yml"
# Extra databases (config/postgres/10-databases.sh)
DB_EXTRA="openvtb:postgis openformulieren:postgis,pg_trgm nlportal gzac iko"
# Versies: de G4-componenten op hun laatste release van september 2026, Open
# Formulieren op de 3.5-lijn (zoals in PodiumD en bij de G4-gemeenten in productie).
IMAGE_OPENFORMULIEREN=openformulieren/open-forms:3.5.8
IMAGE_GZAC_BACKEND=ritense/gzac-backend:13.48.0
IMAGE_GZAC_FRONTEND=ritense/gzac-frontend:13.48.0
# Hostpoorten van deze stack: 8200 tot en met 8249. Redis-databases: 12 tot en met 18
# (12 tot en met 17 via maykin, 18 voor IKO).
PORT_OPENVTB=8201
PORT_OPENFORMULIEREN=8202
PORT_NLPORTAL=8203
PORT_NLPORTAL_BACKEND=8204
PORT_GZAC=8205
PORT_GZAC_BACKEND=8206
PORT_IKO=8207
