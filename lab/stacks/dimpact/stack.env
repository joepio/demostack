# Stack "dimpact": wat PodiumD draait (bron: Helm-chart podiumd 4.9.3, values.yaml).
STACK_TITEL="Dimpact PodiumD 4.9.3: KISS, ITA, PABC, Open Formulieren, Open Inwoner, Open Archiefbeheer, Open Beheer, OMC op de registers"
STACK_STATUS=werkt
STACK_COMPOSE="stacks/kern/compose.yml stacks/dimpact/compose.yml"
# Extra databases (config/postgres/10-databases.sh)
DB_EXTRA="objecten:postgis objecttypen openformulieren:postgis,pg_trgm openinwoner:postgis,pg_trgm openarchiefbeheer:postgis openbeheer kiss ita pabc"
# Hostpoorten van deze stack: 8150 tot en met 8199. Redis-databases: 12 tot en met 21.
#
# Versies uit podiumd 4.9.3 (charts/podiumd/values.yaml). Daar staan ze met digest;
# hier volstaat de tag.
IMAGE_OPENZAAK=openzaak/open-zaak:1.29.3
IMAGE_OPENNOTIFICATIES=openzaak/open-notificaties:1.16.2
IMAGE_OPENKLANT=maykinmedia/open-klant:2.15.0
IMAGE_REFERENTIELIJSTEN=maykinmedia/referentielijsten-api:0.7.4
# Keycloak: PodiumD draait 26.7.3 (quay.io). quay.io is hier niet bereikbaar; de
# basis-Keycloak 26.4.7 speelt zowel de DigiD-simulatie als de medewerkers-IdP.
# IMAGE_KEYCLOAK=quay.io/keycloak/keycloak:26.7.3
