# Extra geheimen voor stack "dimpact". scripts/stack.sh vult .env hiermee aan;
# "__GENEREER__" wordt een willekeurig geheim (alleen lokaal gebruiken).

# Host-poorten (bereik van deze stack: 8150 tot en met 8199). Open Formulieren en Open
# Inwoner houden de poort uit stack maykin (8102 en 8103): dezelfde component heeft in
# elke stack dezelfde hostpoort.
PORT_OPENFORMULIEREN=8102
PORT_OPENINWONER=8103
PORT_OBJECTEN=8150
PORT_OBJECTTYPEN=8151
PORT_OPENARCHIEFBEHEER=8154
PORT_OPENBEHEER=8155
PORT_KISS=8156
PORT_ITA=8157
PORT_PABC=8158
PORT_OMC=8159
PORT_MAILPIT=8160

# Django SECRET_KEYs
SECRET_KEY_OBJECTEN=__GENEREER__
SECRET_KEY_OBJECTTYPEN=__GENEREER__
SECRET_KEY_OPENFORMULIEREN=__GENEREER__
SECRET_KEY_OPENINWONER=__GENEREER__
SECRET_KEY_OPENARCHIEFBEHEER=__GENEREER__
SECRET_KEY_OPENBEHEER=__GENEREER__

# Objecten en Objecttypen (los, zoals PodiumD)
OBJECTTYPEN_OBJECTEN_TOKEN=__GENEREER__
OBJECTEN_PODIUMD_TOKEN=__GENEREER__
OPENOBJECT_OPENFORMULIEREN_TOKEN=__GENEREER__
OPENOBJECT_OPENINWONER_TOKEN=__GENEREER__

# Open Formulieren: API-token van de beheergebruiker (seed maakt er formulieren mee)
OPENFORMULIEREN_BEHEER_TOKEN=__GENEREER__

# ZGW-JWT clients bij Open Zaak
ZGW_OPENFORMULIEREN_SECRET=__GENEREER__
ZGW_OPENINWONER_SECRET=__GENEREER__
ZGW_KISS_SECRET=__GENEREER__
ZGW_ITA_SECRET=__GENEREER__
ZGW_OMC_SECRET=__GENEREER__
ZGW_OPENARCHIEFBEHEER_SECRET=__GENEREER__
ZGW_OPENBEHEER_SECRET=__GENEREER__

# Tokens bij Open Klant
OPENKLANT_OPENINWONER_TOKEN=__GENEREER__
OPENKLANT_KISS_TOKEN=__GENEREER__
OPENKLANT_ITA_TOKEN=__GENEREER__
OPENKLANT_OMC_TOKEN=__GENEREER__
OPENKLANT_OPENARCHIEFBEHEER_TOKEN=__GENEREER__

# Keycloak: DigiD-simulatie (realm voorbeeldstad) en medewerkers (realm podiumd)
KEYCLOAK_OPENFORMULIEREN_CLIENT_SECRET=__GENEREER__
KEYCLOAK_OPENINWONER_CLIENT_SECRET=__GENEREER__
KEYCLOAK_KISS_CLIENT_SECRET=__GENEREER__
KEYCLOAK_ITA_CLIENT_SECRET=__GENEREER__
KEYCLOAK_PABC_CLIENT_SECRET=__GENEREER__
KEYCLOAK_OPENARCHIEFBEHEER_CLIENT_SECRET=__GENEREER__
KEYCLOAK_OPENBEHEER_CLIENT_SECRET=__GENEREER__
# Wachtwoord van de fictieve medewerkers kcm.jansen, behandelaar.desai, beheer.devries
MEDEWERKER_WACHTWOORD=__GENEREER__

# PABC (X-API-KEY) en KISS (managementinformatie)
PABC_API_KEY=__GENEREER__
KISS_MANAGEMENTINFORMATIE_API_KEY=__GENEREER__

# OMC: JWT waarmee Open Notificaties zich bij OMC meldt
OMC_AUTH_JWT_SECRET=__GENEREER__
# Sleutel voor de Notify-mock, in het formaat van NotifyNL: naam-serviceId-geheim
# (OMC controleert het formaat; de mock controleert de handtekening niet)
NOTIFY_API_KEY=demogemeente-1b7d1a40-0000-4000-8000-0000000000aa-1b7d1a40-0000-4000-8000-0000000000bb

# Elasticsearch (zoekfunctie van Open Inwoner en KISS)
ELASTIC_PASSWORD=__GENEREER__
