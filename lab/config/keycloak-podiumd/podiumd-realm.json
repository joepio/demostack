{
  "realm": "podiumd",
  "displayName": "Gemeente Voorbeeldstad (medewerkers)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "nl"
  ],
  "defaultLocale": "nl",
  "roles": {
    "realm": [
      {
        "name": "Klantcontactmedewerker",
        "description": "PodiumD-rol Klantcontactmedewerker"
      },
      {
        "name": "Redacteur",
        "description": "PodiumD-rol Redacteur"
      },
      {
        "name": "Kennisbank",
        "description": "PodiumD-rol Kennisbank"
      },
      {
        "name": "Beheerder",
        "description": "PodiumD-rol Beheerder"
      },
      {
        "name": "ITA-Toegang",
        "description": "PodiumD-rol ITA-Toegang"
      },
      {
        "name": "ITA-Functioneel-Beheerder",
        "description": "PodiumD-rol ITA-Functioneel-Beheerder"
      },
      {
        "name": "PABC-Functioneel-Beheerder",
        "description": "PodiumD-rol PABC-Functioneel-Beheerder"
      },
      {
        "name": "Superuser",
        "description": "PodiumD-rol Superuser"
      }
    ]
  },
  "clients": [
    {
      "clientId": "kiss",
      "name": "KISS",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_KISS_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:${PORT_KISS}/*",
        "http://127.0.0.1:${PORT_KISS}/*",
        "http://kiss.local:8080/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "rollen",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
