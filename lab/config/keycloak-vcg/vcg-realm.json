{
  "realm": "vcg",
  "displayName": "Gemeente Voorbeeldstad (medewerkers)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "nl",
    "en"
  ],
  "defaultLocale": "nl",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "Behandelaar",
        "description": "Behandelt zaken"
      },
      {
        "name": "Functioneel-Beheerder",
        "description": "Beheert catalogi, organisatie en publicaties"
      },
      {
        "name": "Superuser",
        "description": "Volledige beheerrechten in de Maykin-componenten"
      }
    ]
  },
  "clients": [
    {
      "clientId": "openbeheer",
      "name": "Open Beheer",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_OPENBEHEER_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:${PORT_OPENBEHEER}/*",
        "http://127.0.0.1:${PORT_OPENBEHEER}/*",
        "http://openbeheer.local:8000/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "rollen",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "openorganisatie",
      "name": "Open Organisatie",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_OPENORGANISATIE_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:${PORT_OPENORGANISATIE}/*",
        "http://127.0.0.1:${PORT_OPENORGANISATIE}/*",
        "http://openorganisatie.local:8000/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "rollen",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
