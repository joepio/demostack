COMPOSE_PROJECT_NAME=oedemo
D=demostack.nl
# Zelf genereren: het geheim dat Open Notificaties meestuurt naar /notificaties
OE_NOTIFICATIES_TOKEN=vul-in
# Uit de .env van de kern-stack (OE_ZGW_SECRET; client openevents bij Open Zaak en Open Notificaties)
OE_ZGW_SECRET=vul-in
# Zelf genereren (openssl rand -hex 32): sleutel voor BSN-pseudoniemen. Wisselen = volume oedemo_data wissen.
OE_PSEUDONYM_KEY=vul-in
# Zelf genereren (openssl rand -hex 32): de simulator tekent hiermee zijn tokens
OE_JWT_SECRET=vul-in
